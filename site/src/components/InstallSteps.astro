---
/** Три кроки встановлення на головній — картки зі штифтами-номерами. */
import Stud from './svg/Stud.astro';
import { langOf, localePath, STRINGS } from '../i18n/strings';

const lang = langOf(Astro.locals);
const t = STRINGS[lang].install;
const steps = t.steps;
---

<ol class="steps not-content">
  {
    steps.map((s, i) => (
      <li class="step">
        <span class="step__num" aria-hidden="true">
          <Stud size={44} tone={i === 2 ? 'red' : 'yellow'} />
          <b>{i + 1}</b>
        </span>
        <h3>{s.title}</h3>
        <p set:html={s.html} />
      </li>
    ))
  }
</ol>
<p class="steps-more not-content">
  {t.more} <a href={localePath(lang, 'install/')}>{t.moreLink}</a>.
</p>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
  }

  .step {
    position: relative;
    padding: 1.6rem 1.1rem 1.1rem;
    margin-top: 1rem;
    border-radius: var(--radius);
    background: var(--paper-raised);
    border: 1px solid var(--sl-color-hairline-light);
    box-shadow: var(--shadow);
  }

  .step__num {
    position: absolute;
    top: -1.4rem;
    left: 1rem;
    display: grid;
    place-items: center;
  }

  .step__num b {
    position: absolute;
    top: 0.32rem;
    font: 800 1.05rem var(--font-display);
    color: #2b1d12;
  }

  .step:nth-child(3) .step__num b {
    color: #fff;
  }

  h3 {
    margin: 0.3rem 0 0.35rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--sl-color-white);
  }

  p {
    margin: 0;
    color: var(--ink-muted);
  }

  code {
    font-size: 0.85em;
    padding: 0.05rem 0.3rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--leather) 16%, transparent);
    color: var(--ink);
  }

  .steps-more {
    margin-top: 1rem;
    font-size: 0.92rem;
  }

  .steps-more a {
    color: var(--link);
  }
</style>
