---
/**
 * Шапка: власний знак проєкту (цеглинка з «Ї»), назва, пошук, головні розділи,
 * соцмережі, перемикач теми й мови (українська — корінь, англійська — /en/). Жодних логотипів правовласників.
 */
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import ProjectMark from '../svg/ProjectMark.astro';
import { langOf, localePath, STRINGS } from '../../i18n/strings';

const lang = langOf(Astro.locals);
const t = STRINGS[lang].header;
const path = Astro.url.pathname;
const nav = t.nav.map((n) => ({ href: localePath(lang, n.page), label: n.label }));

// Та сама сторінка іншою мовою: усі сторінки існують в обох деревах (перевіряє sync-docs і збірка).
const base = localePath('uk');
const isNotFound = Astro.locals.starlightRoute.entry.id === '404' || path.endsWith('/404.html');
const pageInLocale = path.startsWith(localePath('en')) ? path.slice(localePath('en').length) : path.slice(base.length);
const counterpart = isNotFound ? localePath(t.switchTo.lang) : localePath(t.switchTo.lang, pageInLocale);
---

<div class="header">
  <div class="title-wrapper">
    <a href={localePath(lang)} class="site-title" aria-label={t.homeLabel}>
      <ProjectMark size={30} />
      <span class="site-title__text" translate="no">
        <span class="site-title__kicker">{t.kicker}</span>
        <span class="site-title__name">{t.name}</span>
      </span>
    </a>
  </div>
  <div class="search-wrapper print:hidden">
    <Search />
    <a class="lang-short" href={counterpart} hreflang={t.switchTo.lang} lang={t.switchTo.lang} aria-label={t.switchTo.label}
      >{t.switchTo.short}</a
    >
  </div>
  <div class="right-group print:hidden">
    <nav class="top-nav" aria-label={t.navLabel}>
      {
        nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <div class="social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
    display: flex;
  }

  .site-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--sl-color-white);
    min-width: 0;
  }

  .site-title :global(.project-mark) {
    flex: none;
    transition: transform 0.2s ease;
  }

  .site-title:hover :global(.project-mark) {
    transform: rotate(-8deg) translateY(-1px);
  }

  .site-title__text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    min-width: 0;
    white-space: nowrap;
  }

  .site-title__kicker {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--leather);
  }

  .site-title__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.12rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-wrapper {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* На вузьких екранах без бічної панелі (головна) немає мобільного меню з перемикачем мови. */
  .lang-short {
    display: none;
    padding: 0.2rem 0.5rem;
    border-radius: 0.4rem;
    border: 1px solid var(--sl-color-gray-5);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--ink);
    text-decoration: none;
  }

  .lang-short:hover {
    background: color-mix(in srgb, var(--leather) 18%, transparent);
  }

  @media (max-width: 49.99rem) {
    :global(:root:not([data-has-sidebar])) .lang-short {
      display: inline-flex;
    }
  }

  .right-group {
    display: none;
    align-items: center;
    gap: 1rem;
  }

  .top-nav {
    display: none;
    gap: 0.2rem;
  }

  .top-nav a {
    padding: 0.35rem 0.6rem;
    border-radius: 0.4rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .top-nav a:hover {
    background: color-mix(in srgb, var(--leather) 18%, transparent);
  }

  .top-nav a[aria-current='page'] {
    background: var(--brick-red-face);
    color: var(--on-brick);
  }

  .social-icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  @media (max-width: 26rem) {
    .site-title__kicker {
      display: none;
    }
    .site-title__name {
      font-size: 1rem;
    }
  }

  @media (min-width: 50rem) {
    .right-group {
      display: flex;
    }
  }

  @media (min-width: 78rem) {
    .top-nav {
      display: flex;
    }
  }
</style>
