---
/**
 * Знак проєкту: цеглинка 3×4 згори, жовті штифти складають літеру «Ї»
 * (дві крапки й стовпчик). Кольори — з CSS-змінних, тож знак змінюється з темою.
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 36, class: className, title } = Astro.props;
const cols = [9, 20, 31];
const rows = [10, 20.7, 31.3, 42];
// [col, row] штифтів, що утворюють «Ї»
const letter = new Set(['0,0', '2,0', '1,1', '1,2', '1,3']);
---

<svg
  class:list={['project-mark', className]}
  width={size}
  height={Math.round((size * 52) / 40)}
  viewBox="0 0 40 52"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <rect x="2" y="5" width="36" height="46" rx="4" fill="var(--brick-red-side)" />
  <rect x="2" y="2" width="36" height="46" rx="4" fill="var(--brick-red-face)" />
  <rect x="3.5" y="3.5" width="33" height="43" rx="3" fill="none" stroke="#fff" stroke-opacity=".18" />
  {
    rows.map((y, r) =>
      cols.map((x, c) =>
        letter.has(`${c},${r}`) ? (
          <g>
            <circle cx={x} cy={y + 1} r="4.1" fill="var(--brick-yellow-side)" />
            <circle cx={x} cy={y} r="4.1" fill="var(--brick-yellow)" />
            <circle cx={x - 1.2} cy={y - 1.2} r="1.3" fill="#fff" fill-opacity=".55" />
          </g>
        ) : (
          <g>
            <circle cx={x} cy={y + 0.8} r="3.9" fill="#000" fill-opacity=".22" />
            <circle cx={x} cy={y} r="3.9" fill="var(--brick-red-face)" stroke="#fff" stroke-opacity=".22" stroke-width=".8" />
          </g>
        ),
      ),
    )
  }
</svg>
